# Keys under the `auth` namespace. `tr!(auth::login_title())` maps
# to the Fluent key `auth__login-title` — `::` becomes `__`, the
# trailing `_title` becomes `-title`.
auth__login-title = Sign in
auth__logout-title = Sign out
